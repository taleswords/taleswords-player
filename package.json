{
  "name": "@taleswords/player",
  "version": "0.1.1",
  "description": "Embeddable Taleswords story player: one script tag for any website, or a React or Vue 3 component. Plays published interactive stories; read-only, no credentials.",
  "license": "MIT",
  "author": "Taleswords",
  "homepage": "https://github.com/taleswords/taleswords-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taleswords/taleswords-player.git"
  },
  "bugs": {
    "url": "https://github.com/taleswords/taleswords-player/issues"
  },
  "keywords": [
    "taleswords",
    "interactive-fiction",
    "story-player",
    "embeddable",
    "interactive-story",
    "embed",
    "react",
    "vue"
  ],
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "unpkg": "./build/player.iife.js",
  "jsdelivr": "./build/player.iife.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./components": {
      "types": "./build/components.d.ts",
      "import": "./build/components.js"
    },
    "./browser": {
      "types": "./build/browser.d.ts",
      "import": "./build/browser.js"
    },
    "./react": {
      "types": "./build/react.d.ts",
      "import": "./build/react.js"
    }
  },
  "files": [
    "build/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "del ./build/",
    "build": "npm run clean && tsc && vite build",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "del-cli": "7.0.0",
    "happy-dom": "^20.14.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "4.1.11",
    "vue": "^3.5.43"
  }
}
