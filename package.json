{
  "name": "@taleswords/player",
  "version": "0.0.0",
  "description": "Embeddable Taleswords story player: a one-script-tag bundle for static sites, plus components for the major frontend frameworks.",
  "license": "MIT",
  "author": "Taleswords",
  "homepage": "https://github.com/taleswords/taleswords-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taleswords/taleswords-player.git"
  },
  "bugs": {
    "url": "https://github.com/taleswords/taleswords-player/issues"
  },
  "keywords": [
    "taleswords",
    "interactive-fiction",
    "story-player",
    "embeddable"
  ],
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "unpkg": "./build/player.iife.js",
  "jsdelivr": "./build/player.iife.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./components": {
      "types": "./build/components.d.ts",
      "import": "./build/components.js"
    },
    "./browser": {
      "types": "./build/browser.d.ts",
      "import": "./build/browser.js"
    }
  },
  "files": [
    "build/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "del ./build/",
    "build": "npm run clean && tsc && vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "del-cli": "^7.0.0",
    "happy-dom": "^20.14.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.43"
  }
}
